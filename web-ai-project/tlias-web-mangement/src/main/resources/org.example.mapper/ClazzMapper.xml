    <select id="list" resultType="org.example.Clazz">
        select c.*,e.name masterName,
        (CASE WHEN CURRENT_DATE() &lt; c.begin_date THEN '未开班'
        WHEN CURRENT_DATE() &gt; c.end_date THEN '已结课' ELSE '在读'
        END ) status from clazz c left join emp e on c.master_id = e.id
        <where>
            <if test="name != null and name != ''">
                c.name like concat('%',#{name},'%')
            </if>
            <if test="begin != null ">
                AND c.end_date &gt;= #{begin}
            </if>
            <if test="end != null ">
                AND c.end_date &lt;= #{end}
            </if>
        </where>
        order by c.update_time desc
    </select>

</mapper>